// Shams Tex Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules
//
// Phone numbers are stored as E.164 (+20...) for new accounts. Legacy accounts
// in local format are still allowed read access by the same authenticated phone
// (digit-suffix match) until they re-authenticate and get migrated to E.164.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helpers ============
    function isSignedIn() {
      return request.auth != null;
    }

    function userPhone() {
      // We use phone as document ID for customers; the auth token's phone_number must match.
      return request.auth.token.phone_number;
    }

    function getRole(phone) {
      return get(/databases/$(database)/documents/customers/$(phone)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && getRole(userPhone()) == role;
    }

    // Owner phone numbers — auto-recognized as admin even without a Firestore doc.
    // This ensures the owner can always manage settings and orders, even on first login.
    function isOwnerPhone() {
      return isSignedIn() && (
        request.auth.token.phone_number == '+201221131138' ||
        request.auth.token.phone_number == '+200000000001'
      );
    }

    function isAdmin() {
      return hasRole('admin') || isOwnerPhone();
    }

    function isStaff() {
      return isSignedIn() && (
        isOwnerPhone() ||
        getRole(userPhone()) == 'admin' ||
        getRole(userPhone()) == 'supervisor' ||
        getRole(userPhone()) == 'employee'
      );
    }

    function hasPermission(perm) {
      return isSignedIn() &&
        perm in get(/databases/$(database)/documents/customers/$(userPhone())).data.permissions;
    }

    // ============ Customers / Users ============
    // doc id = phone number
    match /customers/{phone} {
      // Anyone signed in can read their own profile; staff can read all
      allow read: if isSignedIn() && (phone == userPhone() || isStaff());

      // A user may create/update their OWN doc but cannot self-promote.
      allow create: if isSignedIn() && phone == userPhone()
        && request.resource.data.role in ['customer', 'merchant'];

      // Self-update: allowed except role/permissions/vip changes
      allow update: if isSignedIn() && phone == userPhone()
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])
        && request.resource.data.get('vip', false) == resource.data.get('vip', false);

      // Staff with manage permission OR admin can do everything
      allow write: if isAdmin() || hasPermission('manage_users');
      allow delete: if isAdmin();
    }

    // ============ Products ============
    match /products/{productId} {
      allow read: if true; // catalog is public
      allow write: if isAdmin() || hasPermission('manage_products');
    }

    // ============ Orders ============
    match /orders/{orderId} {
      // Customer can read their own order; staff can read all
      allow read: if isSignedIn() && (
        resource.data.userPhone == userPhone() || isStaff()
      );

      // Customer can create their own order
      allow create: if isSignedIn()
        && request.resource.data.userPhone == userPhone()
        && request.resource.data.status in ['pending', 'scheduled'];

      // Customer may edit only their own order if it is editable
      allow update: if isSignedIn() && resource.data.userPhone == userPhone()
        && resource.data.get('editable', false) == true
        && request.resource.data.status == resource.data.status;

      // Customer may update payment-only fields (method, fee, totals derived
      // from method, transfer-proof image) on their own order while it is still
      // pending/scheduled — without requiring `editable=true`. Status, items,
      // assignment, and ownership must NOT change.
      allow update: if isSignedIn()
        && resource.data.userPhone == userPhone()
        && resource.data.status in ['pending', 'scheduled']
        && request.resource.data.status == resource.data.status
        && request.resource.data.userPhone == resource.data.userPhone
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentMethod', 'paymentFee', 'totalWithFee', 'transferProofImage'
          ]);

      // Customer may cancel their own order while it is still pending or
      // scheduled (i.e. before staff has started working on it). Only the
      // status field may change, and it must transition to 'cancelled'.
      allow update: if isSignedIn()
        && resource.data.userPhone == userPhone()
        && resource.data.status in ['pending', 'scheduled']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.userPhone == resource.data.userPhone
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Staff can update orders (status, assignment, etc.)
      allow update: if isStaff() && (isAdmin() || hasPermission('edit_orders'));

      // Staff with manage_payments may set payment-override fields even
      // without full edit_orders permission.
      allow update: if isStaff()
        && (isAdmin() || hasPermission('manage_payments'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentOverrideHandle', 'paymentOverrideName', 'paymentMethod',
            'paymentFee', 'totalWithFee'
          ]);

      // Only admin can delete orders
      allow delete: if isAdmin();
    }

    // ============ Notifications ============
    match /notifications/{notifId} {
      // Read your own notification or staff broadcast
      allow read: if isSignedIn();
      // Anyone signed in can mark-as-read (write merge for read flag) is fine
      allow update: if isSignedIn();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    // ============ Settings (Config) ============
    match /config/{docId} {
      allow read: if true; // pricing settings, payment info — public read
      allow write: if isAdmin()
        || hasPermission('manage_settings')
        || hasPermission('manage_payments');
    }

    // ============ Return Requests ============
    match /returnRequests/{reqId} {
      allow read: if isSignedIn() && (
        resource.data.userPhone == userPhone() || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.userPhone == userPhone();
      allow update: if isStaff() && (isAdmin() || hasPermission('manage_returns') || hasPermission('cancel_returns'));
      allow delete: if isAdmin();
    }

    // ============ Sessions (single-device login) ============
    match /sessions/{phone} {
      // Only the owning phone can read/write its session token
      allow read, write: if isSignedIn() && phone == userPhone();
    }

    // ============ OTP rate limiting ============
    // Accessed BEFORE Firebase Auth (during phone-number step), so unauthenticated
    // reads/writes are allowed but with strict shape & monotonic count constraints
    // to prevent tampering. Limit enforced client-side: 3 per 24h.
    match /otpThrottle/{phone} {
      allow read: if true;
      allow create: if request.resource.data.count == 1
        && request.resource.data.windowStart is int;
      allow update: if (
        // Same window — count must increment by exactly 1 and stay <= 10.
        (request.resource.data.windowStart == resource.data.windowStart
         && request.resource.data.count == resource.data.count + 1
         && request.resource.data.count <= 10)
        ||
        // New window — reset to count = 1.
        (request.resource.data.windowStart > resource.data.windowStart
         && request.resource.data.count == 1)
      );
      allow delete: if isAdmin();
    }

    // ============ Push Tokens ============
    match /pushTokens/{phone} {
      // User manages their own token; staff can read all to broadcast
      allow read: if isSignedIn() && (phone == userPhone() || isStaff());
      allow write: if isSignedIn() && phone == userPhone();
      allow delete: if isSignedIn() && (phone == userPhone() || isAdmin());
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
